# Copy to .env (gitignored) and fill in. docker compose reads this automatically.

# OAuth Web client ID from Google Cloud Console -> APIs & Services -> Credentials.
# Authorized JavaScript origins: http://localhost:3000, http://localhost:5173
GOOGLE_CLIENT_ID=

# HMAC key for session JWTs. Generate: openssl rand -hex 32
SESSION_SECRET=

# Who may sign in is controlled in Google Cloud Console (consent-screen
# Testing mode + test-user list) — no app-side allowlist.

# Set to 1 when serving over HTTPS (public deploy).
COOKIE_SECURE=

# Production only (docker-compose.prod.yml): the public hostname Caddy serves
# with auto-TLS, e.g. bonds.example.com. Leave unset locally.
DOMAIN=
