# Copy to .env (gitignored) and fill in. docker compose reads this automatically.

# OAuth Web client ID from Google Cloud Console -> APIs & Services -> Credentials.
# Authorized JavaScript origins: http://localhost:3000, http://localhost:5173
GOOGLE_CLIENT_ID=

# HMAC key for session JWTs. Generate: openssl rand -hex 32
SESSION_SECRET=

# Who may sign in is controlled in Google Cloud Console (consent-screen
# Testing mode + test-user list) — no app-side allowlist.

# Set to 1 when serving over HTTPS (public deploy).
COOKIE_SECURE=

# Zerodha Kite Connect app (developers.kite.trade — free for personal use).
# Set the app's redirect URL to {origin}/api/kite/callback, e.g.
# http://localhost:3000/api/kite/callback locally. Each user connects their
# own Zerodha account; leave blank to disable Kite (scraper depth only).
KITE_API_KEY=
KITE_API_SECRET=

# When BondLens is served on more than one domain: Kite allows a single
# redirect URL, so after login the callback bounces the user back to the
# domain they started on — but only to one of these (comma-separated),
# e.g. https://bonds-a.example.com,https://bonds-b.example.com
KITE_REDIRECT_ORIGINS=

# Production only (docker-compose.prod.yml): the public hostname Caddy serves
# with auto-TLS, e.g. bonds.example.com. Leave unset locally.
DOMAIN=
