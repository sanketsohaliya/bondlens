# DOMAIN comes from .env via compose. With a real domain Caddy provisions
# Let's Encrypt certs automatically; with the ":80" fallback it serves plain HTTP.

{$DOMAIN} {
	encode gzip
	reverse_proxy web:80
}

# Legacy DuckDNS host serves the app directly (fallback for networks/agents
# that distrust the new bondlens.in domain until its reputation builds).
bondlens.duckdns.org {
	encode gzip
	reverse_proxy web:80
}

www.bondlens.in {
	redir https://bondlens.in{uri} permanent
}
