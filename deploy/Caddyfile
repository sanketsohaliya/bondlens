# DOMAIN comes from .env via compose. With a real domain Caddy provisions
# Let's Encrypt certs automatically; with the ":80" fallback it serves plain HTTP.

# No HTTP/3: some ISPs mangle UDP 443, and browsers that upgrade via the
# Alt-Svc hint then show intermittent ERR_SSL_* errors. h1+h2 only.
{
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy web:80
}

# Legacy DuckDNS host and www — permanent redirect to the canonical domain.
# NOTE: DOMAIN must be bondlens.in (a duplicate host across blocks is a
# config error). Remove the duckdns entry once old links have migrated.
www.bondlens.in, bondlens.duckdns.org {
	redir https://bondlens.in{uri} permanent
}
