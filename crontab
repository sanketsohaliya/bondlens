# BondLens scheduled jobs — run by supercronic inside the `jobs` container.
# Times are IST (TZ=Asia/Kolkata baked into the image). supercronic skips
# a schedule if its previous run is still going, so no flock needed.

# 1) Bond universe build — 05:30 Mon-Sat (after NSE's ~03:00 master regen)
30 5 * * 1-6 cd /app && python -m backend.universe

# 2) NSDL harvest + parse — 07:00 daily. ';' not '&&': parse what was
#    fetched even if some calls failed.
0 7 * * * cd /app && python scripts/harvest_nsdl.py --workers 8; python scripts/parse_nsdl.py; python scripts/compute_analytics.py

# 2b) NSDL midday retry - 13:00 daily, only if the 07:00 run failed
#     (--if-failed-today exits at once otherwise). Covers a transient
#     morning outage without anyone being paged; parse/compute are
#     idempotent no-ops when nothing new was fetched.
0 13 * * * cd /app && python scripts/harvest_nsdl.py --workers 8 --if-failed-today; python scripts/parse_nsdl.py; python scripts/compute_analytics.py

# 3) EOD trades harvest + parse — 19:00 Mon-Fri (exchanges publish ~16-18h)
0 19 * * 1-5 cd /app && python scripts/harvest_eod.py; python scripts/parse_eod.py; python scripts/compute_analytics.py

# 4) EOD safety retry — 07:15 Tue-Sat (late publications; idempotent)
15 7 * * 2-6 cd /app && python scripts/harvest_eod.py; python scripts/parse_eod.py; python scripts/compute_analytics.py

# 5) Weekly backup — Saturday 08:00, overwrites /desktop/bondlens.dump
0 8 * * 6 cd /app && python scripts/backup_db.py

# 6) Healthcheck — after the morning window (08:45) and evening EOD (19:45);
#    pushes to ntfy on problems, silent when healthy.
45 8 * * * cd /app && python scripts/healthcheck.py
45 19 * * 1-5 cd /app && python scripts/healthcheck.py

# 7) Portfolio notifications — 07:30 daily (after the NSDL parse/analytics)
#    and 19:30 Mon-Fri (after the EOD parse, for price-anomaly alerts).
#    Idempotent via the (user_id, dedupe_key) unique constraint.
30 7 * * * cd /app && python scripts/generate_notifications.py
30 19 * * 1-5 cd /app && python scripts/generate_notifications.py

# 8) Kite fill sweep — every 10 min during market hours (Mon-Fri): turns
#    filled bond BUYs into portfolio lots for users with a live token.
#    Idempotent via the kite_fills (user_id, order_id) primary key.
*/10 9-16 * * 1-5 cd /app && python scripts/sweep_kite_fills.py

20 8,19 * * * cd /app && python scripts/harvest_corporate_actions.py capture --mode recent --dispatch-history

# 9) Opportunity-alert thresholds — 08:30 Mon-Fri, after the 07:00 NSDL
#    parse: solve today's yield -> price table so the watcher only reads
#    at 09:00 (it builds on its own too; this is belt and braces).
30 8 * * 1-5 cd /app && python scripts/build_thresholds.py
